<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waveshare_servos</name>
  <version>1.0.0</version>
  <description>
    ros2_control hardware interface for Waveshare ST series serial bus servos (Feetech SMS/STS
    protocol), tested with the ST3025 on the Waveshare Bus Servo Adapter. Position and velocity
    joints, multi-turn wheel positions, synchronized bus reads and writes, and command-line tools
    to scan a bus, change a servo id, calibrate the midpoint and factory-reset a servo.
  </description>
  <maintainer email="jhat@uw.edu">lab</maintainer>
  <license file="LICENSE">GPL-3.0-or-later</license>
  <!-- bringup/launch/example.launch.py and include/visibility_controls.h carry Apache-2.0
       headers (see THIRD_PARTY.md). -->
  <license file="LICENSES/Apache-2.0.txt">Apache-2.0</license>
  <url type="repository">https://github.com/htchr/waveshare_servos</url>
  <url type="bugtracker">https://github.com/htchr/waveshare_servos/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- The plugin and its public header. -->
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <!-- The tools read rcl's global parameter overrides directly (src/tool_main.cpp). -->
  <depend>rcl</depend>
  <depend>rcl_yaml_param_parser</depend>

  <!-- The example bringup (launch/, config/, description/) and the ros2 commands used with it. -->
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros2controlcli</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ros2run</exec_depend>
  <exec_depend>ros2topic</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Test-only. The tests also use controller_manager, launch, launch_ros and xacro, which are
       exec_depends above. See docs/development.md, "Development rules". -->
  <!-- Test build tooling. CMakeLists.txt registers cpplint itself, without its copyright rule. -->
  <test_depend>ament_cmake_cpplint</test_depend>
  <test_depend>ament_cmake_gmock</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <!-- The gmock tests (test/*.cpp). -->
  <test_depend>lifecycle_msgs</test_depend>
  <test_depend>rcutils</test_depend>
  <test_depend>ros2_control_test_assets</test_depend>
  <!-- The Python tests. controller_manager.test_utils, imported by test_example_launch.py,
       needs launch_testing_ros and sensor_msgs. -->
  <test_depend>ament_index_python</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <!-- test/test_release_metadata.py -->
  <test_depend>python3-catkin-pkg-modules</test_depend>
  <test_depend>python3-docutils</test_depend>
  <!-- The bench test: test/hil_check.sh and its recorder test/hil/hil_record.py (which also
       uses rclpy and sensor_msgs). -->
  <test_depend>builtin_interfaces</test_depend>
  <test_depend>control_msgs</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>trajectory_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
