<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="example_ws_ros2_control"
                 params="name prefix port:=/dev/ttyACM0 baudrate:=1000000">

        <!-- Optional, ros2_control 4.48 - read and write the hardware at its own rate, and/or on
             its own thread. Both are ATTRIBUTES of this element, not <param> children of
             <hardware>, and an attribute the parser does not know is dropped without a word, so a
             typo looks like nothing happened. Pick an rw_rate that divides the update_rate: at
             update_rate 100, rw_rate 60 is reported by `ros2 control list_hardware_components` as
             60 Hz and actually runs at 50, while 0 or anything above update_rate is silently
             treated as update_rate. /joint_states keeps publishing at update_rate either way - a
             lower rw_rate does not slow the topic down, it makes each value repeat. This package
             sets neither: rw_rate 50 halves bus occupancy but fails this package's own velocity
             gate on a wheel near 2 rad/s, and is_async changed no measurable number at four
             servos. See the README, "Running the bus slower, or off the control thread". To use
             one, add the attribute to the live tag below; this copy is only the shape, and xacro
             does not expand anything inside a comment.
        <ros2_control name="..." type="system" rw_rate="50" is_async="true">
        -->
        <ros2_control name="${name}" type="system">
            <hardware>
                <plugin>waveshare_servos/WaveshareServos</plugin>
                <param name="port">${port}</param>
                <param name="baudrate">${baudrate}</param>
                <!-- Optional, shown with their defaults and deliberately left out so this example
                     exercises them -
                     io_timeout_ms 5, ping_attempts 3, max_read_fails 50,
                     allow_missing_servos false, protocol sms_sts, feedback_mode auto,
                     encoder_steps 4096, current_per_count_a 0.006,
                     torque_constant_nm_per_a 0.8825985 -->
            </hardware>
        
            <!-- State interfaces are free-form - declare any subset of position, velocity,
                 effort, current, voltage, temperature, load and status, in any order. `torque` is
                 a deprecated alias of `effort` that keeps reporting kg cm instead of N m. -->
            <joint name="${prefix}joint1">
                <param name="id">1</param>
                <param name="type">pos</param>
                <param name="offset">1.570796</param>
                <command_interface name="position">
                    <param name="min">-1.570796</param>
                    <param name="max">1.570796</param>
                </command_interface>
                <command_interface name="velocity">
                    <param name="min">-9.2</param>
                    <param name="max">9.2</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="temperature"/>
            </joint>

            <joint name="${prefix}joint2">
                <param name="id">2</param>
                <param name="type">pos</param>
                <param name="offset">1.570796</param>
                <command_interface name="position">
                    <param name="min">-1.570796</param>
                    <param name="max">1.570796</param>
                </command_interface>
                <command_interface name="velocity">
                    <param name="min">-9.2</param>
                    <param name="max">9.2</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="temperature"/>
            </joint>

            <joint name="${prefix}joint3">
                <param name="id">3</param>
                <param name="type">vel</param>
                <command_interface name="velocity">
                    <param name="min">-9.2</param>
                    <param name="max">9.2</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="temperature"/>
            </joint>

            <!-- The second wheel, id 4, the same shape as joint3 - the example declares four
                 joints because the reference bench carries four servos (ids 1-4), and a
                 three-joint example on a four-servo bus leaves one servo unread and unwritten.
                 A mirrored wheel pair is what `inverted` exists for - the right-hand wheel of a
                 differential drive would add a param inverted of true, which flips its two
                 command interfaces together with its position, velocity and load states, so that
                 one positive velocity drives the pair forward. It is deliberately left off here,
                 because the URDF beside this file is a serial chain rather than a mirrored pair,
                 so an inverted joint4 would spin its servo opposite to the model RViz draws, and
                 this file is what a new user copies first. See the bench description under
                 test/hil/descriptions for `inverted` exercised on hardware. -->
            <joint name="${prefix}joint4">
                <param name="id">4</param>
                <param name="type">vel</param>
                <command_interface name="velocity">
                    <param name="min">-9.2</param>
                    <param name="max">9.2</param>
                </command_interface>
                <state_interface name="position"/>
                <state_interface name="velocity"/>
                <state_interface name="effort"/>
                <state_interface name="temperature"/>
            </joint>

        </ros2_control>

    </xacro:macro>

</robot>